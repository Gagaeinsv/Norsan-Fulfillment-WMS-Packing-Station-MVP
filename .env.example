# ==========================================
# NORSAN WMS — Configurazione Variabili d'Ambiente
# Copia in .env e adatta i valori per il deploy
# ==========================================

# Server HTTP Backend
PORT=3001
NODE_ENV=production

# Adapter Corriere (mock | sandbox | live)
# Mantenere "mock" finché non vengono fornite le credenziali DHL Business API
CARRIER_MODE=mock
DHL_API_KEY=
DHL_ACCOUNT_NUMBER=

# Sincronizzazione API diretta Selly ERP (opzionale; import CSV Zero-API funziona senza)
SELLY_API_URL=https://api.sellyerp.com/v1
SELLY_API_KEY=
SELLY_SYNC_INTERVAL_MIN=5
SELLY_AUTO_SYNC=false

# Amazon SP-API (opzionale; usata per verifica stato integrazioni e sync futura)
AMAZON_SP_REFRESH_TOKEN=

# Controller Hardware Pick-to-Light (ESP32 WS2812B)
ESP32_IP=192.168.1.200
ESP32_PORT=80
P2L_TIMEOUT_MS=800

# Variabile Build Frontend (usata da Vite quando il backend gira su host/dominio separato)
# Esempio per host LAN Bolzano: http://192.168.1.50:3001/api
# Esempio per VPS Cloud dietro HTTPS: https://api-wms.norsan.example/api
VITE_API_BASE=
