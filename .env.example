# ==========================================
# NORSAN WMS — Environment Configuration
# Copy to .env and adjust values for deployment
# ==========================================

# Backend HTTP Server
PORT=3001
NODE_ENV=production

# Carrier Adapter (mock | sandbox | live)
# Stay on "mock" until DHL Business API credentials are issued
CARRIER_MODE=mock
DHL_API_KEY=
DHL_ACCOUNT_NUMBER=

# Selly ERP Direct API Sync (optional; CSV Zero-API works without it)
SELLY_API_URL=https://api.sellyerp.com/v1
SELLY_API_KEY=
SELLY_SYNC_INTERVAL_MIN=5
SELLY_AUTO_SYNC=false

# Amazon SP-API (optional; used for readiness checks & future sync)
AMAZON_SP_REFRESH_TOKEN=

# Pick-to-Light Hardware Controller (ESP32 WS2812B)
ESP32_IP=192.168.1.200
ESP32_PORT=80
P2L_TIMEOUT_MS=800

# Frontend Build Variable (used by Vite when backend runs on a separate host/domain)
# Example for Bolzano LAN host: http://192.168.1.50:3001/api
# Example for Cloud VPS behind HTTPS: https://api-wms.norsan.example/api
VITE_API_BASE=
